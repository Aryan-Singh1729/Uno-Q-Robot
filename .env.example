# One or more comma-separated keys; requests rotate only after HTTP 429.
GROQ_API_KEY=gsk_replace_me,gsk_optional_backup
# Optional comma-separated Cerebras text-LLM keys. Groq remains STT and vision.
CEREBRAS_API_KEYS=
DEEPGRAM_API_KEY=replace_me
# Optional overrides
ROBOT_NAME=WALL-E
LLM_MODEL=openai/gpt-oss-120b
# With Cerebras keys, you may instead use: LLM_MODEL=zai-glm-4.7
VISION_MODEL=qwen/qwen3.6-27b
STT_MODEL=whisper-large-v3-turbo
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
PLAYBACK_GAIN=3.0
CAMERA_INDEX=0
# Optional stable serial path; otherwise /dev/ydlidar and /dev/ttyUSB* are detected.
# LIDAR_PORT=/dev/ydlidar
# The X2 stop distance is fixed at exactly 10 cm in code.
# Optional: prefer the stable microphone name; numeric USB IDs can change after reconnects.
# MIC_DEVICE=EMEET SmartCam C950: USB Audio
# OUTPUT_DEVICE=1
